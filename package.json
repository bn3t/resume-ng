{
  "name": "resume-ng",
  "private": true,
  "version": "1.8.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run astro:build && start-server-and-test preview:export http://localhost:5173 export:puppeteer",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "export:puppeteer": "node src/export.js",
    "dev": "astro dev",
    "start": "astro dev",
    "astro:build": "astro build",
    "preview": "astro preview",
    "preview:export": "astro preview --ignore-lock",
    "test:integration": "playwright test --config ./playwright-integration.config.ts",
    "test:screenshots": "playwright test --config ./playwright-screenshots.config.ts",
    "ncu": "ncu -u"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.2",
    "@fontsource-variable/league-gothic": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "astro": "^7.4.4",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.66.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "postcss-selector-parser": "^7.1.6",
    "yaml-language-server": {
      "yaml": "^2.9.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "copy-file": "^11.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^6"
  }
